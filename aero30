const load=k=>{try{return JSON.parse(localStorage.getItem(k))||[]}catch(e){return []}};
const put=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const N=(x,d=1)=>x.toFixed(d), m3=a=>((a%360)+360)%360, pick=(a,b,s=1)=>a+s*Math.floor(Math.random()*((b-a)/s+1));
const side=x=>x>0?'вправо':x<0?'влево':'на ЛЗП';

// Тест: банк вопросов без повторов, тест заканчивается
let seen=load('aero30_seen'), run=[], ri=0, rok=0, wrong=[], answered=false;
function testStart(){
  const left=Q.map((_,i)=>i).filter(i=>!seen.includes(i));
  $('#test').innerHTML='<div class="card"><b>Тест: до 10 вопросов</b><p class="mut">Вопросы не повторяются, пока не пройден весь банк ('+Q.length+' вопросов). Непройденных: '+left.length+'.</p>'+(left.length?'<button class="pri" id="go">Начать тест</button>':'<p class="ans">Банк пройден полностью.</p><button id="reset">Сбросить историю и начать заново</button>')+'</div>';
}
function testGo(){
  run=Q.map((_,i)=>i).filter(i=>!seen.includes(i)).sort(()=>Math.random()-.5).slice(0,10);
  ri=0;rok=0;wrong=[];testQ();
}
function testQ(){
  const q=Q[run[ri]];answered=false;
  $('#test').innerHTML='<div class="card"><p class="mut">Вопрос '+(ri+1)+' из '+run.length+'</p><b>'+q.q+'</b>'+q.a.map((x,i)=>'<button class="opt" data-i="'+i+'">'+x+'</button>').join('')+'<p class="ans" id="ex"></p></div><button class="pri" id="nx" hidden>'+(ri+1<run.length?'Дальше':'Завершить')+'</button>';
}
function testEnd(){
  $('#test').innerHTML='<div class="card"><b>Тест завершён</b><p class="ans">Верно: '+rok+' из '+run.length+'</p>'+(wrong.length?'<p class="mut">Ошибки:</p>'+wrong.map(w=>'<p>'+w+'</p>').join(''):'<p>Ошибок нет.</p>')+'</div><button class="pri" id="again">К банку вопросов</button>';
}
$('#test').onclick=e=>{
  const t=e.target;
  if(t.id==='go'){testGo();return;}
  if(t.id==='reset'){seen=[];put('aero30_seen',seen);testStart();return;}
  if(t.id==='again'){testStart();return;}
  if(t.id==='nx'){ri++;ri<run.length?testQ():testEnd();return;}
  if(answered||t.dataset.i===undefined)return;
  answered=true;
  const q=Q[run[ri]], i=+t.dataset.i, btns=document.querySelectorAll('#test .opt');
  seen.push(run[ri]);put('aero30_seen',seen);
  if(i===q.c){rok++;t.classList.add('good');}else{t.classList.add('bad');btns[q.c].classList.add('good');wrong.push(q.q+' Верно: '+q.a[q.c]);}
  $('#ex').textContent=(i===q.c?'Верно. ':'Неверно. ')+(q.e||T[q.t-1][1]);
  $('#nx').hidden=false;
};

// Тренировка задач: 5 задач, числа новые, задачи не повторяются
let used=load('aero30_tasks'), tasks=[], ti=0, tok=0;
function gen0(){
  const V=pick(200,320,10), U=pick(30,80,5), B=pick(20,160,10);
  const us=Math.asin(U*Math.sin(B*r)/V)/r, kuv=us+B, W=V*Math.sin(kuv*r)/Math.sin(B*r);
  return {sig:'0|'+V+'|'+U+'|'+B,
    text:'Истинная скорость Vи = '+V+' уз, ветер U = '+U+' уз, угол ветра УВ = '+B+'°. Найдите угол сноса УС и путевую скорость W.',
    f:[['УС, °',us,0.5],['W, уз',W,3]],
    s:['sin УС = U·sin УВ / Vи, отсюда УС = '+N(us)+'°','КУВ = УС + УВ = '+N(kuv)+'°','W = Vи·sin КУВ / sin УВ = '+N(W)+' уз']};
}
function gen1(){
  const Z=pick(100,260,5), d=pick(-12,12,2), us=pick(-8,8,1), sp=pick(20,60,5), so=pick(20,80,5);
  const bu=d+us; if(!bu)return null;
  const MK=Z+d, dp=bu*sp/so, pk=bu+dp, mp=MK-pk;
  return {sig:'1|'+Z+'|'+d+'|'+us+'|'+sp+'|'+so,
    text:'ЗМПУ = '+Z+'°, МК = '+MK+'°, УС = '+us+'°, Sпр = '+sp+' нм, Sост = '+so+' нм. Найдите БУ, ДП и МК ППМ.',
    f:[['БУ, °',bu,0.5],['ДП, °',dp,0.5],['МК ППМ, °',mp,0.5]],
    s:['ФМПУ = МК + УС = '+(MK+us)+'°, БУ = ФМПУ − ЗМПУ = '+N(bu)+'°','ДП = БУ·Sпр/Sост = '+N(dp)+'°','ПК = БУ + ДП = '+N(pk)+'°, МК ППМ = МК − ПК = '+N(mp)+'°']};
}
function gen2(){
  const mk=pick(0,350,10), kur=pick(0,350,10), z=pick(0,350,10), on=Math.random()<.5;
  if(on){
    const mp=m3(mk+kur), dp=nm(z-mp);
    return {sig:'2|1|'+mk+'|'+kur+'|'+z,
      text:'Полёт НА радиостанцию. МК = '+mk+'°, КУР = '+kur+'°, ЗМПУ = '+z+'°. Найдите МПР и ДП.',
      f:[['МПР, °',mp,1],['ДП, °',dp,1]],
      s:['МПР = МК + КУР = '+N(mp,0)+'°','ДП = ЗМПУ − МПР = '+N(dp,0)+'° ('+side(dp)+')']};
  }
  const mps=m3(mk+kur+180), bu=nm(mps-z);
  return {sig:'2|0|'+mk+'|'+kur+'|'+z,
    text:'Полёт ОТ радиостанции. МК = '+mk+'°, КУР = '+kur+'°, ЗМПУ = '+z+'°. Найдите МПС и БУ.',
    f:[['МПС, °',mps,1],['БУ, °',bu,1]],
    s:['МПС = МК + КУР + 180° = '+N(mps,0)+'°','БУ = МПС − ЗМПУ = '+N(bu,0)+'° ('+side(bu)+')']};
}
function gen3(){
  const p=pick(740,765,1), eh=pick(2000,6000,500), oh=pick(0,200,10), vv=pick(200,400,20), w=pick(150,300,10);
  const nb=(760-p)*11, nn=eh-nb-oh, t=nn/vv, S=w*t/60;
  return {sig:'3|'+p+'|'+eh+'|'+oh+'|'+vv+'|'+w,
    text:'Давление аэродрома '+p+' мм рт.ст., Нэш = '+eh+' м, Нотх = '+oh+' м, Vв = '+vv+' м/мин, W = '+w+' уз. Найдите Нбар, время и путь набора.',
    f:[['Нбар, м',nb,2],['t набора, мин',t,0.3],['S набора, нм',S,0.3]],
    s:['Нбар = (760 − p)·11 = '+N(nb,0)+' м','Ннаб = Нэш − Нбар − Нотх = '+N(nn,0)+' м','tнаб = Ннаб / Vв = '+N(t)+' мин','Sнаб = W·tнаб / 60 = '+N(S)+' нм']};
}
const GEN=[gen0,gen1,gen2,gen3];
function newTasks(){
  tasks=[]; let g=0;
  while(tasks.length<5&&g++<1000){
    const x=GEN[Math.floor(Math.random()*4)]();
    if(!x||used.includes(x.sig)||tasks.some(y=>y.sig===x.sig))continue;
    tasks.push(x); used.push(x.sig);
  }
  used=used.slice(-800); put('aero30_tasks',used);
  ti=0; tok=0; taskView();
}
function taskView(){
  const x=tasks[ti];
  $('#drill').innerHTML='<div class="card"><p class="mut">Задача '+(ti+1)+' из '+tasks.length+'</p><p>'+x.text+'</p>'+x.f.map((y,i)=>'<label>'+y[0]+'</label><input id="a'+i+'" inputmode="decimal">').join('')+'<p><button class="pri" id="chk">Проверить</button></p><div id="sol"></div></div>';
}
function check(){
  const x=tasks[ti]; let good=0; const lines=[];
  x.f.forEach((y,i)=>{
    const v=parseFloat(String($('#a'+i).value).replace(',','.')), ok=Math.abs(v-y[1])<=y[2];
    if(ok)good++;
    lines.push((ok?'✓ ':'✗ ')+y[0]+': ваш ответ '+(isNaN(v)?'—':N(v))+', верно '+N(y[1]));
  });
  if(good===x.f.length)tok++;
  $('#chk').disabled=true;
  $('#sol').innerHTML='<p class="ans">'+lines.join('<br>')+'</p><p class="mut">Решение:<br>'+x.s.join('<br>')+'</p><button class="pri" id="nxt">'+(ti+1<tasks.length?'Дальше':'Итог')+'</button>';
}
function drillStart(){
  $('#drill').innerHTML='<div class="card"><b>Тренировка задач</b><p class="mut">5 задач с новыми числами. Задачи не повторяются между тренировками. Типы: треугольник скоростей, коррекция пути на ППМ, радиокомпас, набор высоты.</p></div><button class="pri" id="newt">Начать тренировку</button>';
}
$('#drill').onclick=e=>{
  const t=e.target;
  if(t.id==='newt')newTasks();
  else if(t.id==='chk')check();
  else if(t.id==='nxt'){
    ti++;
    if(ti<tasks.length)taskView();
    else $('#drill').innerHTML='<div class="card"><b>Тренировка завершена</b><p class="ans">Решено верно: '+tok+' из '+tasks.length+'</p></div><button class="pri" id="newt">Новая тренировка</button>';
  }
};

const TH=[
['Аэронавигация и требования к ней',['Аэронавигация — наука о том, как вести самолёт из одной точки земли в другую точно, надёжно и безопасно, по заданной в пространстве траектории.','ПМС — точка, где в данный момент находится центр масс самолёта. МС — её проекция на землю. Линия, которую описывает МС, — линия пути. Требования: безопасность (главное), точность, экономичность, регулярность.']],
['Системы координат',['Геодезическая система — широта и долгота на эллипсоиде Земли. Сферическая — широта φ и долгота λ на шаре. За форму Земли берут геоид — поверхность, совпадающую со средним уровнем морей.','Ортодромия — дуга большого круга, самый короткий путь между двумя точками на сфере. Линии заданного пути в навигации обычно задают ортодромией. Локсодромия пересекает меридианы под постоянным углом. Частноортодромическая система строится для каждого участка: одна ось — линия пути, вторая — ЛБУ. По ней видно пройденное и оставшееся расстояние.']],
['Навигационные и пилотажные элементы. Условия движения по ЛЗП. Разворот',['Пилотажные элементы — крен, тангаж, курс: угловое положение самолёта. Навигационные — координаты и движение, то есть скорость.','Vи — скорость относительно воздуха, W — путевая скорость относительно земли, ФПУ — направление W относительно меридиана, ЗПУ — направление линии пути. Условия движения по ЛЗП: ЛБУ = 0 и ФПУ = ЗПУ.','Радиус разворота R = V²/(g·tg x), где x — угол крена. Линейное упреждение ЛУР = R·tg(УР/2), где УР = ЗПУ2 − ЗПУ1.']],
['Магнитный меридиан и магнитное склонение. Правило учёта поправок',['Магнитное склонение ΔМ — угол между истинным и магнитным меридианами, к востоку со знаком «плюс». Девиация ΔК — между магнитным и компасным меридианами. Вариация Δ = ИК − КК. Условное склонение ΔМу = ОК − МК.','Правило: от приборных величин к истинным поправки прибавляют, от истинных к приборным — вычитают. Цепочка: КК, ΔК, МК, ΔМ, ИК, ΔА, ОК.']],
['Ветер и его характеристики. Эквивалентный ветер',['Ветер — горизонтальное движение воздушных масс. Навигационное направление δн — куда дует ветер, метеорологическое α — откуда. Связь: δн = α ± 180° − ΔМ, знак выбирают так, чтобы результат попадал в диапазон от 0° до 360°. Скорость ветра U — скорость воздуха относительно земли.','Эквивалентный ветер — условный ветер вдоль линии пути, который даёт ту же путевую скорость, что и реальный ветер при той же воздушной скорости: Uэкв = W − Vи.']],
['Навигационный треугольник скоростей и связь его элементов',['Треугольник строится из векторов Vи, U и W, при этом W = V + U. Курс К — угол между меридианом и направлением Vи. Путевой угол ФПУ — направление W. Угол сноса УС = ФПУ − К (плюс — вправо). Угол ветра УВ = δн − ФПУ. Курсовой угол ветра КУВ = УС + УВ = δн − К.','Теорема синусов: sin УВ / V = sin УС / U = sin КУВ / W.']],
['Зависимость путевой скорости и угла сноса от угла ветра',['УВ = 0: попутный ветер, W = V + U, снос нулевой. УВ = 180°: встречный ветер, W = V − U, снос тоже нулевой.','При УВ = 90° снос максимальный и положительный, при УВ = 270° — максимальный и отрицательный, а путевая скорость примерно равна V. Приближённо УС ≈ 57,3·(U/V)·sin УВ.']],
['Принципы измерения курса. Магнитный компас КИ-13. Девиация',['КИ-13 — простой магнитный компас: плюсы — простота, надёжность, не нужен ток. Минусы — низкая точность, большие ошибки на разворотах, долгое успокоение, плохая работа в полярных районах. Курс можно измерять магнитным, гироскопическим, астрономическим и инерциальным принципами.','Девиация — ошибка компаса из-за железа на самолёте. Полукруговая и четвертная зависят от курса. Креновая возникает при развороте и тангаже, ускорительная — при разгоне и торможении. Постоянная девиация — из-за неточности изготовления. Девиацию списывают на разных курсах и уменьшают компенсаторами.']],
['Гироскопический принцип измерения курса. Выставка оси гироскопа. Коррекции',['Гироскоп сохраняет направление своей оси. Карданов подвес даёт три степени свободы. Гирополукомпас ГПК сам не знает, где север: пилот выставляет его ось по выбранному направлению, и дальше прибор показывает курс относительно этой оси.','Горизонтальная коррекция — маятник с пузырьком и контактами возвращает ось в горизонтальное положение. Азимутальная коррекция компенсирует уход оси из-за вращения Земли. Скорость ухода зависит от широты, поэтому широту задают на пульте.']],
['Ортодромичность гирополукомпаса',['При полёте по ортодромии ось гироскопа сохраняет постоянный угол с ней, поэтому гироскопический курс остаётся постоянным. Для этого ГПК нужны азимутальная и горизонтальная коррекции.','Относительно текущего меридиана курс со временем меняется. При переходе по ортодромии путевой угол меняется на величину угла схождения меридианов.']],
['Опорный меридиан и ортодромический курс. Преобразование курсов',['Опорный меридиан — начало отсчёта курса: истинный, магнитный или выбранный пилотом. Ортодромический курс ОК отсчитывают от его северного направления. Азимутальная поправка ΔА — угол между опорным и истинным меридианами, к востоку со знаком «плюс».','Формулы: ОК = ИК + ΔА и ОК = МК + ΔМ + ΔА. Если опорный меридиан истинный, ΔА = (λ0 − λ)·sin φср. Если магнитный, ΔА = (λ0 − λ)·sin φср − ΔМ0. Здесь λ0 — долгота точки начальной выставки, λ — текущая долгота, φср — средняя широта участка.']],
['Основные сведения о курсовых системах. Режим магнитной коррекции',['Курсовая система объединяет магнитный и гироскопический принципы, и недостатки одного компенсирует другой. В состав входят индукционный датчик (измеряет магнитный курс), коррекционный механизм (устраняет часть девиации), гироагрегат, указатели курса, выключатель коррекции (отключает её на развороте) и пульт.','В режиме магнитной коррекции индукционный датчик измеряет компасный курс, коррекционный механизм убирает нормальную статическую девиацию, а следящий двигатель всё время поворачивает ось гироскопа к магнитному меридиану. На указателе — магнитный курс. Есть также режимы ГПК и астрономической коррекции.']],
['Классификация высот полёта',['Истинная высота — расстояние от земли под самолётом до самолёта. Абсолютная — от среднего уровня моря. Относительная — от выбранного уровня, чаще всего от аэродрома.','Радиовысотомер измеряет истинную высоту по времени, за которое радиоволна доходит до земли и возвращается: Δt = 2H/c, где c — скорость радиоволн.']],
['Принцип работы и устройство барометрического высотомера',['Это барометр-анероид, у которого шкала проградуирована в единицах высоты. Чувствительный элемент — герметичная гофрированная анероидная коробка, из которой откачан воздух.','При подъёме внешнее давление падает, коробка расширяется, при снижении сжимается. Передающий механизм переводит это движение на стрелку, и стрелка показывает высоту.']],
['Погрешности барометрического высотомера и их учёт',['Инструментальные — из-за неточности изготовления и износа, определяют сравнением с эталоном и заносят в таблицу на борту. Аэродинамические — из-за искажения потока у приёмника давления, учитываются по таблице с поправками для эшелонов.','Методические — из-за того, что реальная атмосфера отличается от стандартной. Если фактическая температура ниже стандартной, высотомер завышает показания, и наоборот. Прочие: неточная установка давления, запаздывание, локальные изменения давления.']],
['Правила установки давления на шкале высотомера. Вертикальное эшелонирование',['QNE — стандартное давление 760 мм рт. ст., по нему летают на эшелонах. QFE — давление аэродрома, для взлёта и посадки. QNH — давление аэродрома, приведённое к уровню моря по стандартной атмосфере.','Порядок: перед вылетом на шкале стоит QFE. На высоте перехода все ставят QNE. При снижении до эшелона перехода снова ставят QFE или QNH и сообщают диспетчеру контрольную высоту. Эшелонирование — разнос самолётов по вертикали с установленным интервалом.']],
['Расчёт элементов маневрирования высотой полёта',['Поправка на давление аэродрома: Нбар = (760 − p)·11 м при p в мм рт. ст. или Нбар = (1013,2 − p)·8,3 м при p в гПа. Набор: Ннаб = Нэш − Нбар − Нотх, время tнаб = Ннаб / Vв, путь Sнаб = W·tнаб, время прибытия на эшелон Tнаб = Тотх + tнаб.','Снижение: Нсн = Нэш − Нподх − Нбар, tсн = Нсн / Vв, Sсн = W·tсн. Потребная вертикальная скорость Vверт = ΔH′ / tрасп, где Sрасп = Sсн − Sзад, tрасп = Sрасп / W. Если есть ограничение скорости, снижение считают в два этапа и суммируют.']],
['Принцип работы однострелочного указателя скорости. Приборная скорость',['Указатель измеряет скоростной напор — разность полного и статического давления, которые берут с приёмника воздушного давления. Манометрическая коробка расширяется или сжимается, и стрелка показывает приборную скорость Vпр.','Воздух считают несжимаемым до скоростей 400–450 км/ч и высот 4–5 км. На малых высотах Vпр близка к истинной, а при наборе с постоянной Vпр истинная скорость растёт.']],
['Комбинированный указатель скорости',['На больших скоростях и высотах нужен КУС с двумя стрелками. Широкая показывает приборную скорость, как обычный указатель. Узкая учитывает высоту: её механизм связан с блоком анероидных коробок, которые расширяются при подъёме.','Температуру прибор не измеряет и использует стандартную для высоты. Поэтому широкая стрелка отличается от истинной из-за плотности и давления на высоте, а узкая — из-за разницы между фактической и стандартной температурой. На больших высотах узкая стрелка почти совпадает с истинной скоростью.']],
['Погрешности указателей скорости',['Инструментальные — из-за неточности изготовления и износа, определяют сравнением с эталоном. Аэродинамические — из-за искажения потока у приёмника, зависят от скорости и высоты, определяют в лётных испытаниях и заносят в таблицу.','Методические — из-за сжимаемости воздуха. Выше 350–400 км/ч воздух перед приёмником сжимается, показания завышаются (Vпр больше Vи). Поэтому поправка на сжимаемость всегда отрицательна. По узкой стрелке её не учитывают.']],
['Расчёт истинной воздушной скорости',['Поправки складываются от приборной скорости к истинной: инструментальная и аэродинамическая дают Vинд.зем, поправка на сжимаемость — Vинд, методическая поправка по высоте — истинную скорость Vи.','Методическая поправка в процентах от высоты: 1 км — 5%, 2 км — 10%, 3 км — 15%, 4 км — 20%, 5 км — 25%, 6 км — 30%, 7 км — 40%, 8 км — 50%, 9 км — 60%, 10 км — 70%. Поправку на сжимаемость берут по таблице по высоте и приборной скорости. Расчёт удобно вести на НЛ-10М.']],
['Понятие о счислении пути',['Счисление — определение места самолёта по известному начальному месту и навигационным элементам: курсу, путевой скорости и углу сноса. Вычисляют не координаты целиком, а их приращение за время полёта.','Абсолютные методы (радионавигация, спутники, визуальная ориентировка) дают место только в отдельные моменты. Счисление даёт непрерывную информацию, но ошибки накапливаются. Если счисление прервали, его надо начинать заново с точно известного места.']],
['Графическое счисление координат',['Полная прокладка — с учётом ветра: ФИПУ = ФМПУ + ΔМ = МК + УС + ΔМ = ИК + УС. Минус в том, что на каждом участке нужно записывать много величин.','Штилевая прокладка — без ветра: путевой угол равен курсу, скорость равна истинной. Затем штилевое место смещают по направлению ветра на Sотн = U·tобщ. Обратная прокладка — уточнение уже после полёта по фактическому месту: невязку ΔS распределяют по точкам маршрута пропорционально времени.']],
['Основные правила аэронавигации при полёте по маршруту',['Подготовку делают заранее: предварительную и предполётную. Технологию задаёт руководство по лётной эксплуатации самолёта, но она не может быть жёсткой, потому что обстановка в каждом полёте разная.','Главные правила: контролировать выдерживание траектории и курса, определять навигационные элементы и ветер, рассчитывать время пролёта ППМ, следить за топливом и рубежом ухода на запасной аэродром, комплексно использовать средства навигации.']],
['Этапы маршрутного полёта',['Полёт состоит из взлёта, вылета по схеме, маршрута (набор высоты, горизонтальный полёт, снижение), захода на посадку и посадки. Если посадка невозможна, выполняют уход на второй круг, затем повторный заход, ожидание или полёт на запасной аэродром.','Взлёт и посадка короткие и обычно выполняются в визуальных условиях. Самые сложные с точки зрения навигации — маневры в районе аэродрома: вылет, прибытие и заход на посадку.']],
['Понятие о комплексном применении навигационных средств',['Комплексное применение — разумное использование избыточной информации ради точного и безопасного полёта. Это одно из основных правил аэронавигации. Неполное использование средств — одна из основных причин навигационных происшествий.','Что входит: своевременно выбирать средства и методы, проверять их показания дублирующими средствами (даже самому точному прибору полностью доверять нельзя), знать счисленные координаты, учитывать точность и надёжность каждого средства.']],
['Контроль и исправление пути',['Контроль по направлению определяет сторону и величину ЛБУ. Контроль по дальности — пройденное и оставшееся расстояние или время. Полный контроль — определение места самолёта.','Исправление пути — вывод самолёта на заданную траекторию. Нужны БУ и ДП. Если сразу изменить курс на БУ, самолёт пойдёт параллельно ЛЗП. Чтобы выйти именно в ППМ, добавляют ДП: ПК = БУ + ДП, курс на ППМ МКппм = МК − ПК.']],
['Определение путевой скорости и угла сноса на контрольном этапе',['Контрольный этап — отрезок, на котором определяют параметры. Держат курс, скорость и высоту. Над первой точкой включают секундомер и отмечают место на карте, над второй выключают и отмечают вторую точку, затем соединяют их линией.','Путевая скорость W = S / t, где S — расстояние по карте, t — время. Угол сноса УС = ФИПУ − ИК, где ИК = МК + ΔМ. Чем длиннее контрольный этап, тем точнее результат.']],
['Визуальная ориентировка',['Визуальная ориентировка — сравнение карты с местностью. Сначала обнаруживают ориентир (выделяют его на фоне), затем опознают (сравнивают с картой), затем определяют место самолёта. Ориентир — объект с известным положением, который есть на карте.','Видимость зависит от местности, высоты (выше — дальше видно, но детали мельче), скорости (меньше времени на опознание), освещённости, метеорологической дальности видимости и самих ориентиров: размера, цвета, контраста, формы. Начинают с крупных ориентиров.']],
['Технология навигационной работы экипажа в полёте по маршруту',['После занятия эшелона уточняют место самолёта, записывают в бортжурнал высоту, температуру и остаток топлива, пересчитывают Vи.','На каждом участке: при пролёте ППМ включают секундомер и докладывают диспетчеру, после разворота проверяют курс (ЗПУ + УС), записывают время пролёта и расчётное время следующих точек. За 2 минуты до ППМ прекращают другие операции и контролируют пролёт. По мере необходимости пересчитывают W и УС по фактическому ветру, контролируют путь и курсовые приборы, следят за топливом.']]
];
function renderTheory(){
  let h='<p class="mut">Пересказ простыми словами по дням плана. Дни 1–15 — основное по 30 вопросам зачёта. Дни 16–26 пока с краткими пояснениями, их раскрою дальше.</p>';
  for(let d=0;d<26;d++){
    const a=2*d, b=a+1;
    const part=i=>TH[i]?'<p><b>'+(i+1)+'. '+TH[i][0]+'</b></p>'+TH[i][1].map(p=>'<p>'+p+'</p>').join(''):'<p><b>'+(i+1)+'. '+T[i][0]+'</b></p><p>'+T[i][1]+'</p>';
    h+='<details class="card"><summary>День '+(d+1)+'. '+T[a][0]+' + '+T[b][0]+'</summary>'+part(a)+part(b)+'</details>';
  }
  $('#theory').innerHTML=h;
}
renderTheory();
testStart(); drillStart();

const r=Math.PI/180, nm=a=>((a%360)+540)%360-180, f1=x=>x.toFixed(1);
$('#bn').onclick=()=>{
  const kd=+$('#k').value, dd=+$('#dn').value, V=+$('#v').value, U=+$('#u').value;
  const x=V*Math.sin(kd*r)+U*Math.sin(dd*r), y=V*Math.cos(kd*r)+U*Math.cos(dd*r);
  const W=Math.hypot(x,y), fd=(Math.atan2(x,y)/r+360)%360;
  $('#rn').innerHTML='W = '+f1(W)+' уз<br>ФПУ = '+f1(fd)+'°<br>УС = '+f1(nm(fd-kd))+'°<br>УВ = '+f1(nm(dd-fd))+'°<br>КУВ = '+f1(nm(dd-kd))+'°';
};
$('#bt').onclick=()=>{$('#rt').textContent='t = '+f1(+$('#s').value*60/+$('#w').value)+' мин'};
$('#bs').onclick=()=>{$('#rt').textContent='S = '+f1(+$('#w').value*+$('#t').value/60)+' нм'};
$('#bb').onclick=()=>{$('#rb').innerHTML='По мм рт.ст.: '+Math.round((760-+$('#pm').value)*11)+' м<br>По гПа: '+Math.round((1013.2-+$('#ph').value)*8.3)+' м'};
$('#bu').onclick=()=>{
  const v=+$('#uv').value, u=$('#uu').value;
  const kmh=u==='kmh'?v:u==='kt'?v*1.852:v*3.6;
  $('#ru').innerHTML=f1(kmh)+' км/ч<br>'+f1(kmh/1.852)+' уз<br>'+f1(kmh/3.6)+' м/с';
};
</script>
